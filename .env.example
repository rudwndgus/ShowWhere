FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Main semantic guidance model and deterministic fallback.
FEATHERLESS_GUIDE_MODEL=deepseek-ai/DeepSeek-V3.2
FEATHERLESS_GUIDE_FALLBACK_MODEL=Qwen/Qwen3.6-35B-A3B

# Vision is used only after structured UI semantics are insufficient.
FEATHERLESS_VISION_MODELS=ByteDance-Seed/UI-TARS-1.5-7B,Qwen/Qwen3-VL-30B-A3B-Instruct,Qwen/Qwen3-VL-8B-Instruct

# Optional specialized routes. Leave embedding blank until a real model is selected.
FEATHERLESS_FAST_MODEL=
FEATHERLESS_REASONING_MODEL=deepseek-ai/DeepSeek-V3.2
FEATHERLESS_EMBEDDING_MODEL=
FEATHERLESS_REQUEST_TIMEOUT_MS=30000
FEATHERLESS_MAX_RETRIES=1
FEATHERLESS_RETRY_BASE_DELAY_MS=250
FEATHERLESS_MAX_TOKENS=256
FEATHERLESS_ENABLE_THINKING=false

# Learning pipeline: keep runs small until dry-run output is reviewed.
LEARNING_GENERATOR_MODEL=Qwen/Qwen3.6-35B-A3B
LEARNING_JUDGE_A_MODEL=deepseek-ai/DeepSeek-V3.2
LEARNING_JUDGE_B_MODEL=
LEARNING_JUDGE_C_MODEL=
LEARNING_MAX_EXAMPLES_PER_RUN=50
LEARNING_CONCURRENCY=2
LEARNING_MAX_TOKENS=1400
SHOWWHERE_DEBUG=false
SHOWWHERE_AI_MODE=mock
SHOWWHERE_API_HOST=127.0.0.1
SHOWWHERE_API_PORT=8787
SHOWWHERE_MAX_REQUEST_BYTES=10000000

# Public, non-secret Windows client configuration.
SHOWWHERE_BACKEND_URL=http://127.0.0.1:8787/api/guide
SHOWWHERE_BACKEND_TIMEOUT_SECONDS=75
