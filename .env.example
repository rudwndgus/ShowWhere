# Server-only secret. Never commit the real value.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-terra
OPENAI_STRONG_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# Optional semantic candidate routing. Keep the real token only in .env.
HF_TOKEN=
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large
HF_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_REQUEST_TIMEOUT_MS=4000
HF_MIN_SCORE=0.68
HF_MIN_MARGIN=0.08

# Optional web-crawler semantic model comparison. Comma-separated models are
# benchmarked against Korean/English UI synonym pairs; the best compatible model wins.
# Leave blank for live Hub discovery and a small multilingual benchmark.
CRAWLER_HF_MODEL_CANDIDATES=
# Set only to force one preferred candidate to be evaluated first.
CRAWLER_HF_EMBEDDING_MODEL=

# Git-tracked web Knowledge location. Authentication state is never stored here.
SHOWWHERE_WEB_KNOWLEDGE_DIR=knowledge/web

SHOWWHERE_DEBUG=false
SHOWWHERE_API_HOST=127.0.0.1
SHOWWHERE_API_PORT=8787
SHOWWHERE_MAX_REQUEST_BYTES=12000000

# Public, non-secret Windows client configuration.
SHOWWHERE_BACKEND_URL=http://127.0.0.1:8787/api/guide
SHOWWHERE_BACKEND_TIMEOUT_SECONDS=35
