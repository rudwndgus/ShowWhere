FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_GUIDE_MODEL=zai-org/GLM-4.6
FEATHERLESS_FAST_MODEL=
FEATHERLESS_REASONING_MODEL=
FEATHERLESS_REQUEST_TIMEOUT_MS=15000
FEATHERLESS_MAX_RETRIES=2
FEATHERLESS_RETRY_BASE_DELAY_MS=250
FEATHERLESS_MAX_TOKENS=128
FEATHERLESS_ENABLE_THINKING=false
SHOWWHERE_DEBUG=false
SHOWWHERE_AI_MODE=mock
SHOWWHERE_API_HOST=127.0.0.1
SHOWWHERE_API_PORT=8787
SHOWWHERE_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
SHOWWHERE_MAX_REQUEST_BYTES=1000000

# This is the only API-related value that may be embedded in the extension build.
VITE_SHOWWHERE_GUIDE_API_URL=http://127.0.0.1:8787/api/guide

# Public, non-secret Windows client configuration.
SHOWWHERE_BACKEND_URL=http://127.0.0.1:8787/api/guide
SHOWWHERE_BACKEND_TIMEOUT_SECONDS=75
