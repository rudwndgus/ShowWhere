{
  "name": "showwhere",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch services/api/src/server.ts",
    "start:api": "node services/api/dist/server.js",
    "crawl": "tsx services/crawler/src/cli.ts crawl",
    "crawl:normalize": "tsx services/crawler/src/cli.ts normalize",
    "crawl:patterns": "tsx services/crawler/src/cli.ts patterns",
    "crawl:compress": "tsx services/crawler/src/cli.ts compress",
    "crawl:install": "playwright install chromium",
    "crawl:smoke": "tsx services/crawler/src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src services vite.config.ts vitest.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "build:api": "vite build --mode api",
    "build:windows": "dotnet build apps/windows/ShowWhere.Windows.sln -c Release",
    "test:windows": "dotnet test apps/windows/ShowWhere.Windows.Tests/ShowWhere.Windows.Tests.csproj -c Release",
    "run:windows": "dotnet run --project apps/windows/ShowWhere.Desktop/ShowWhere.Desktop.csproj",
    "publish:windows": "dotnet publish apps/windows/ShowWhere.Desktop/ShowWhere.Desktop.csproj -c Release -r win-x64 --self-contained false -o build/windows",
    "build": "npm run typecheck && npm run build:api",
    "build:all": "npm run build && npm run build:windows"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.25",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
