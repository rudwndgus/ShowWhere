{
  "name": "showwhere",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch services/api/src/server.ts",
    "start:api": "node services/api/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src services learning vite.config.ts vitest.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "build:api": "vite build --mode api",
    "build:windows": "dotnet build apps/windows/ShowWhere.Windows.sln -c Release",
    "test:windows": "dotnet test apps/windows/ShowWhere.Windows.Tests/ShowWhere.Windows.Tests.csproj -c Release",
    "run:windows": "dotnet run --project apps/windows/ShowWhere.Desktop/ShowWhere.Desktop.csproj",
    "publish:windows": "dotnet publish apps/windows/ShowWhere.Desktop/ShowWhere.Desktop.csproj -c Release -r win-x64 --self-contained false -o build/windows",
    "export:corrections": "node scripts/export-developer-corrections.mjs",
    "learning:validate": "tsx learning/cli.ts validate",
    "learning:bootstrap": "tsx learning/cli.ts bootstrap",
    "learning:generate": "tsx learning/cli.ts generate",
    "learning:judge": "tsx learning/cli.ts judge",
    "learning:review-queue": "tsx learning/cli.ts review-queue",
    "learning:review": "tsx learning/cli.ts review",
    "learning:build-dataset": "tsx learning/cli.ts build-dataset",
    "learning:run": "tsx learning/cli.ts run",
    "eval": "tsx learning/cli.ts eval",
    "eval:report": "tsx learning/cli.ts report",
    "brain-v2:export": "python scripts/export-brain-v2.py",
    "brain-v2:models": "powershell -ExecutionPolicy Bypass -File scripts/check-models.ps1",
    "bench:showwhere": "tsx learning/showwhereBench.ts compare",
    "bench:showwhere:legacy": "tsx learning/showwhereBench.ts legacy",
    "bench:showwhere:v2": "tsx learning/showwhereBench.ts v2",
    "brain-v2:smoke": "C:\\ShowWhere_Models\\.venv\\Scripts\\python.exe scripts/smoke-local-models.py all",
    "brain-v2:import-teaching": "python scripts/import-developer-teaching.py",
    "brain-v2:install-learning": "powershell -ExecutionPolicy Bypass -File scripts/install-learning-tools.ps1",
    "build": "npm run typecheck && npm run build:api",
    "build:all": "npm run build && npm run build:windows"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "tsx": "^4.23.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
