<Window x:Class="ShowWhere.Desktop.DeveloperTeachingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowWhere Developer Teaching Mode" Width="980" Height="720"
        MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="ShowWhere Developer Teaching Mode" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="AI는 초안만 만듭니다. 개발자가 편집하고 검증한 데이터만 Gold로 저장됩니다. 좌표는 Gold에 들어가지 않습니다."
                 Margin="0,5,0,12" Foreground="#FF666666" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="1.25*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="1. 사용자 질문" FontWeight="Bold" Margin="0,0,0,4" />
          <TextBox Text="{Binding TeachingUserQuestion, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />
          <TextBlock Text="2. 현재 단계" FontWeight="Bold" Margin="0,12,0,4" />
          <TextBox Text="{Binding TeachingCurrentStage, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />
          <TextBlock Text="3. 올바른 개발자 수정사항" FontWeight="Bold" Margin="0,12,0,4" />
          <TextBox Text="{Binding TeachingDeveloperCorrection, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="130" AcceptsReturn="True" TextWrapping="Wrap" Padding="8" />
          <Button Content="분석 및 라벨링" Command="{Binding AnalyzeTeachingCommand}"
                  Height="38" Margin="0,12,0,0" />
          <Separator Margin="0,14" />
          <TextBlock Text="선택 영역은 현재 안내와 evidence에만 사용됩니다." Foreground="#FF8A5A00" />
          <TextBlock Text="{Binding CorrectionSelectionSummary}" TextWrapping="Wrap" Margin="0,4,0,7" />
          <StackPanel Orientation="Horizontal">
            <Button Content="정답 영역 선택" Command="{Binding CaptureCorrectionCommand}" Padding="12,7" Margin="0,0,7,0" />
            <Button Content="현재 위치 즉시 적용" Command="{Binding SaveCorrectionCommand}" Padding="12,7" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Semantic v2 라벨 미리보기 · 직접 편집 가능" FontWeight="Bold" />
        <TextBox Grid.Row="1" Text="{Binding TeachingPreviewJson, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="8" Margin="0,5,0,8" />
        <Border Grid.Row="2" Background="#FFFFF8E5" BorderBrush="#FFFFD67A" BorderThickness="1" Padding="8" Margin="0,0,0,8">
          <TextBlock Text="{Binding TeachingValidationSummary}" TextWrapping="Wrap" />
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="검증" Command="{Binding ValidateTeachingCommand}" MinWidth="100" Padding="12,7" Margin="0,0,8,0" />
          <Button Content="승인 Gold 저장" Command="{Binding SaveApprovedGoldCommand}" MinWidth="135" Padding="12,7" Margin="0,0,8,0" />
          <Button Content="취소" Command="{Binding CancelCorrectionEditCommand}" MinWidth="80" Padding="12,7" />
        </StackPanel>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Text="저장 위치: training/gold/guidance-steps-v2.jsonl" Margin="0,10,0,0" Foreground="#FF777777" />
  </Grid>
</Window>
