<Window x:Class="ShowWhere.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowWhere Mobile Connection" Icon="Assets/ShowWhere.ico" Width="390" Height="570" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#FFF7F5F5">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Connect Your Phone" FontSize="25" FontWeight="Bold" Foreground="#FF472323" HorizontalAlignment="Center"/>
      <TextBlock Text="Scan the QR code with your phone camera" Margin="0,7,0,12" Foreground="#FF71696B" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <Border Width="285" Height="285" Background="White" BorderBrush="#FFE2DADA" BorderThickness="1" CornerRadius="14" Padding="12">
        <Image Source="{Binding QrImage}" Stretch="Uniform"/>
      </Border>
      <TextBlock Text="PC Verification Code" FontSize="12" Foreground="#FF71696B" HorizontalAlignment="Center" Margin="0,15,0,2"/>
      <TextBlock Text="{Binding PairingCode}" FontSize="34" FontWeight="ExtraBold" Foreground="#FF472323" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding PairingStatus}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF71696B" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <ProgressBar Value="{Binding RemainingProgress, Mode=OneWay}" Maximum="100" Height="5" Foreground="#FF472323"/>
      <TextBlock Text="{Binding RemainingSeconds, StringFormat={}QR refreshes in {0} seconds}" HorizontalAlignment="Center" Margin="0,7,0,0" Foreground="#FF71696B"/>
    </StackPanel>
  </Grid>
</Window>
