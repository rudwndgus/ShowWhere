<UserControl x:Class="ShowWhere.Desktop.AssistantGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <Grid>
    <!-- The sitting sprite has a large transparent canvas, so crop only its character area. -->
    <Border Margin="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Opacity" Value="0" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding CharacterStore.SelectedCharacterKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="monkey" />
                <Condition Binding="{Binding IsStanding, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Opacity" Value="1" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Background>
        <ImageBrush ImageSource="Assets/Assistant/monkey-sit.png"
                    Viewbox="88,84,52,68" ViewboxUnits="Absolute"
                    Stretch="Uniform" AlignmentX="Center" AlignmentY="Bottom"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border.Background>
    </Border>

    <Border Margin="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Opacity" Value="0" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding CharacterStore.SelectedCharacterKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="monkey" />
                <Condition Binding="{Binding IsStanding, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Opacity" Value="1" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Background>
        <ImageBrush ImageSource="Assets/Assistant/monkey-stand.png"
                    Viewbox="32,28,52,72" ViewboxUnits="Absolute"
                    Stretch="Uniform" AlignmentX="Center" AlignmentY="Bottom"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border.Background>
    </Border>

    <Border Margin="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Opacity" Value="0" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CharacterStore.SelectedCharacterKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="robot">
              <Setter Property="Opacity" Value="1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Background>
        <ImageBrush ImageSource="Assets/Assistant/robot.png"
                    Viewbox="85,65,1060,1080" ViewboxUnits="Absolute"
                    Stretch="Uniform" AlignmentX="Center" AlignmentY="Bottom"
                    RenderOptions.BitmapScalingMode="HighQuality" />
      </Border.Background>
    </Border>

    <Border Margin="2">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Opacity" Value="0" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CharacterStore.SelectedCharacterKey, RelativeSource={RelativeSource AncestorType=Window}}" Value="duck">
              <Setter Property="Opacity" Value="1" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border.Background>
        <ImageBrush ImageSource="Assets/Assistant/duck-stand.png"
                    Viewbox="96,96,64,84" ViewboxUnits="Absolute"
                    Stretch="Uniform" AlignmentX="Center" AlignmentY="Bottom"
                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Border.Background>
    </Border>
  </Grid>

</UserControl>
