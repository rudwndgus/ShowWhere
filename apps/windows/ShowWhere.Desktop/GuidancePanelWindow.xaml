<Window x:Class="ShowWhere.Desktop.GuidancePanelWindow"
        x:Name="PanelRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShowWhere" Width="370" Height="700" MinWidth="350" MinHeight="560"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        Closing="OnClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF472323" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF472323" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#80472323" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF24262B" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF6E7179" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFDFE1E5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF7F7F8" />

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Foreground" Value="#FF45474D" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF7F3F3" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BottomActionButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Foreground" Value="#FF45474D" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChatInput" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFCfd2d7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          CornerRadius="14" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.18" Color="#FF16181D" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="White" Margin="18,14,12,12"
            Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="SHOWWHERE"
                   Foreground="{DynamicResource AccentBrush}" FontSize="15"
                   FontWeight="Bold" VerticalAlignment="Center" />

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
          <Button Content="—" Width="30" Height="30" Margin="0,0,2,0"
                  Style="{StaticResource QuietButton}" Padding="0" Click="OnMinimize" ToolTip="최소화" />
          <Button Content="×" Width="30" Height="30" FontSize="20"
                  Style="{StaticResource QuietButton}" Padding="0" Click="OnHide" ToolTip="닫기" />
        </StackPanel>

        <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"
                Command="{Binding MobileConnectCommand}" Margin="0,9,8,0" Padding="7,3"
                  Style="{StaticResource QuietButton}" ToolTip="QR로 휴대폰을 연결하거나 현재 연결을 끊습니다">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#FF25A65A" Margin="0,0,5,0"
                     Visibility="{Binding IsMobileConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding MobileConnectionText}" FontSize="9"/>
          </StackPanel>
        </Button>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,9,0,0">
          <ToggleButton x:Name="SettingsButton" Content="☰" Width="30" Height="30"
                        Margin="0,0,5,0" Padding="0" FontSize="16"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FF45474D" Cursor="Hand" FocusVisualStyle="{x:Null}"
                        ToolTip="캐릭터 설정">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                 Placement="Bottom" HorizontalOffset="-128" VerticalOffset="5"
                 IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}"
                 StaysOpen="False" AllowsTransparency="True">
            <Border Width="165" Background="White" BorderBrush="#FFD9DDE4" BorderThickness="1" Padding="10">
              <StackPanel>
                <TextBlock Text="캐릭터 설정" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="2,0,0,8" />
                <ListBox ItemsSource="{Binding CharacterStore.Options, ElementName=PanelRoot}"
                         DisplayMemberPath="DisplayName" SelectedValuePath="Key"
                         SelectedValue="{Binding CharacterStore.SelectedCharacterKey, ElementName=PanelRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectionChanged="OnCharacterSelectionChanged"
                         BorderThickness="0" Background="Transparent" Padding="0" />
              </StackPanel>
            </Border>
          </Popup>
          <Button Content="LOG" Command="{Binding ToggleLearningHistoryCommand}"
                  Height="30" Margin="0,0,5,0" Padding="8,0" FontSize="10"
                  Style="{StaticResource QuietButton}" ToolTip="O/X/끝 기록을 확인하고 수정·저장합니다"
                  Visibility="{Binding IsDeveloperMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="{Binding DeveloperModeText}" Command="{Binding ToggleDeveloperModeCommand}"
                  Height="30" Padding="8,0" FontSize="10"
                  Style="{StaticResource QuietButton}" ToolTip="GPT 답변 평가와 라벨링을 켜거나 끕니다" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" BorderBrush="#FFECEEF1" BorderThickness="0,1,0,1"
              Padding="18,9" Background="#FFFCFCFD">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding CurrentApplication, StringFormat=현재 앱 · {0}}"
                     Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                     FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,20,0,-9"
                       Foreground="{DynamicResource AccentBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
      </Border>

      <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    Padding="17,12,17,10" Background="White">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="1,4">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="274"
                          Background="{StaticResource SurfaceBrush}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                          CornerRadius="18" Padding="11,9">
                    <TextBlock x:Name="BubbleText" Text="{Binding Text}" TextWrapping="Wrap"
                               FontSize="13" LineHeight="19" Foreground="{StaticResource TextBrush}" />
                  </Border>
                  <Grid Grid.Row="1" Margin="2,4,2,0">
                    <StackPanel Visibility="{Binding DataContext.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CanEvaluate, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Button Content="O 정답" Margin="0,0,5,0" Padding="8,4" FontSize="10"
                              Style="{StaticResource QuietButton}"
                              Command="{Binding DataContext.MarkAnswerCorrectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}" />
                        <Button Content="X 수정" Margin="0,0,5,0" Padding="8,4" FontSize="10"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding DataContext.MarkAnswerIncorrectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Content="끝" Padding="8,4" FontSize="10"
                                Style="{StaticResource QuietButton}"
                                Command="{Binding DataContext.MarkAnswerCompletedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding EvaluationLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               Visibility="{Binding IsEvaluated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Role}" Value="user">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="18" />
                    <Setter TargetName="BubbleText" Property="Foreground" Value="White" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter TargetName="Bubble" Property="Opacity" Value="0.7" />
                    <Setter TargetName="BubbleText" Property="Text" Value="답변을 준비하고 있어요 · · ·" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding ClarificationChoices}" Margin="1,8,1,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" HorizontalContentAlignment="Left"
                        Command="{Binding DataContext.SelectClarificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" Style="{StaticResource QuietButton}"
                        Margin="0,0,0,7" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Panel.ZIndex="20" Background="#FFF7F7F8"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
              Visibility="{Binding IsLearningHistoryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid Margin="14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="DEVELOPER LOG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="어느 질문·답안에서 무엇을 눌렀는지 확인하고 수정 저장할 수 있습니다."
                         FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,8,8" />
            </StackPanel>
            <Button Grid.Column="1" Content="닫기" Command="{Binding ToggleLearningHistoryCommand}"
                    Style="{StaticResource QuietButton}" Padding="8,4" VerticalAlignment="Top" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LearningHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                          CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding DataContext.LearningRatingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Rating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  MinWidth="76" FontSize="10" Padding="4,2" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="8,2" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" />
                      </Grid>
                      <TextBlock Text="질문" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,2" />
                      <TextBox Text="{Binding Goal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               TextWrapping="Wrap" AcceptsReturn="True" MinHeight="34" Padding="5" FontSize="10" />
                      <TextBlock Text="답안" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,2" />
                      <TextBox Text="{Binding Answer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxHeight="90"
                               VerticalScrollBarVisibility="Auto" Padding="5" FontSize="10" />
                      <TextBlock Text="표시/클릭 대상" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,2" />
                      <TextBox Text="{Binding TargetLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Padding="5" FontSize="10" />
                      <TextBlock Text="개발자 코멘트" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,2" />
                      <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38" Padding="5" FontSize="10" />
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{Binding SaveText}" Margin="0,0,6,0"
                                Command="{Binding DataContext.SaveLearningRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="10" />
                        <Button Content="{Binding ToggleText}"
                                Command="{Binding DataContext.ToggleLearningRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="8,4" FontSize="10" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="3" BorderBrush="#FFECEEF1" BorderThickness="0,1,0,0"
              Padding="17,12,17,0" Background="White">
        <Grid>
          <TextBox x:Name="GoalInput" Text="{Binding GoalText, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource ChatInput}"
                   AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="120"
                   VerticalScrollBarVisibility="Auto" Padding="10,9"
                   FontSize="14" Foreground="{StaticResource TextBrush}"
                   BorderBrush="#FFCfd2d7" BorderThickness="1"
                   PreviewKeyDown="OnGoalInputPreviewKeyDown"
                   ToolTip="하고 싶은 일을 입력하세요" />
          <Button Content="보내기" Command="{Binding SubmitCommand}"
                  Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  MinWidth="58" Height="32" Margin="0,0,7,7" Padding="9,5"
                  Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"
                  Foreground="White" FontSize="12" FontWeight="Bold" Cursor="Hand" />
        </Grid>
      </Border>

      <Border Grid.Row="4" Margin="17,9,17,0" Padding="12" MaxHeight="320"
              Background="#FFEFFAF1" BorderBrush="#FF80C990" BorderThickness="1" CornerRadius="9"
              Visibility="{Binding IsPositiveConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="✓ 이 안내가 정확합니까?" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="사용자 질문" FontSize="11" FontWeight="SemiBold" Margin="0,9,0,3" />
            <TextBox Text="{Binding PositiveQuestion}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
            <TextBlock Text="현재 상황" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,3" />
            <TextBox Text="{Binding PositiveSituation}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
            <TextBlock Text="안내 대상" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,3" />
            <TextBox Text="{Binding PositiveTarget}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
            <TextBlock Text="선택 코멘트" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,3" />
            <TextBox Text="{Binding PositiveCommentText, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"
                     TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
              <Button Content="취소" Command="{Binding CancelPositiveAnswerCommand}" Style="{StaticResource QuietButton}" Margin="0,0,7,0" />
              <Button Content="확인" Command="{Binding ConfirmPositiveAnswerCommand}" Style="{StaticResource QuietButton}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="4" Margin="17,9,17,0" Padding="12" MaxHeight="370"
              Background="#FFFFF9E8" BorderBrush="#FFFFD778" BorderThickness="1"
              CornerRadius="9"
              Visibility="{Binding IsCorrectionEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="개발자 교정 모드" FontSize="13" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="X로 선택한 답변을 수정합니다. 질문의 정확한 뜻이 다르면 아래에 적어 주세요."
                     TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                     Margin="0,4,0,7" />
          <TextBlock Text="{Binding CorrectionDataDirectory, StringFormat=이 PC의 학습 저장 위치 · {0}}"
                     TextWrapping="Wrap" FontSize="9" Foreground="{StaticResource MutedBrush}"
                     Margin="0,0,0,7" ToolTip="EXE에서도 이 폴더에 저장되며 즉시 현재 실행에 반영됩니다" />
          <TextBlock Text="사용자 질문" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,3" />
          <TextBox Text="{Binding CorrectionQuestion}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
          <TextBlock Text="현재 상황" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,3" />
          <TextBox Text="{Binding CorrectionCurrentSituation}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
          <TextBlock Text="잘못 가리킨 대상" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,3" />
          <TextBox Text="{Binding CorrectionWrongTarget}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" />
          <TextBlock Text="왜 틀렸나요?" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,3" />
          <ComboBox ItemsSource="{Binding CorrectionErrorReasons}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding CorrectionErrorReason}" Padding="7,5" />
          <TextBlock Text="올바른 다음 단계 *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,3" />
          <TextBox Text="{Binding CorrectionIntentText, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6"
                   ToolTip="예: Bluetooth 및 장치로 이동" />
          <TextBlock Text="개발자 코멘트" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,8,0,4" />
          <TextBox Text="{Binding CorrectionCommentText, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6"
                   ToolTip="무엇이 틀렸고 어떻게 고쳐야 하는지 자유롭게 적으세요" />
          <StackPanel Visibility="Collapsed">
          <TextBlock Text="GPT 피드백 라벨" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,10,0,4" />
          <TextBlock Text="점(.)으로 계층을 구분합니다. 빈칸은 현재 질문과 화면에서 자동 생성합니다."
                     TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
          <TextBox Text="{Binding CorrectionTaskId, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,5"
                   ToolTip="작업 ID 예: windows.printer.add" />
          <TextBox Text="{Binding CorrectionStateId, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,5"
                   ToolTip="현재 상태 예: windows.settings.home" />
          <TextBox Text="{Binding CorrectionTargetConcept, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,5"
                   ToolTip="정답 대상 예: windows.settings.printers_scanners" />
          <TextBox Text="{Binding CorrectionExpectedNextState, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,5"
                   ToolTip="예상 다음 상태 예: windows.settings.printers_scanners" />
          <TextBox Text="{Binding CorrectionExpectedEvidence, UpdateSourceTrigger=PropertyChanged}"
                   MinHeight="38" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,5" Margin="0,0,0,5"
                   ToolTip="성공 증거를 쉼표 또는 줄바꿈으로 입력" />
          <ComboBox ItemsSource="{Binding CorrectionOutcomeLabels}" SelectedItem="{Binding CorrectionOutcomeLabel}"
                    Padding="7,5" ToolTip="오답 원인 또는 학습 결과 라벨" />
          </StackPanel>
          <TextBlock Text="{Binding CorrectionSelectionSummary}" TextWrapping="Wrap"
                     FontSize="10" Foreground="#FF7A5A16" Margin="0,7,0,0" />
          <CheckBox IsChecked="{Binding SaveCorrectionScreenshot}" Margin="0,8,0,7" Visibility="Collapsed"
                    FontSize="11" Foreground="{StaticResource TextBrush}"
                    Content="학습용 전체 화면을 로컬에 저장" />
          <TextBlock Text="드래그는 미리보기일 뿐 저장되지 않습니다. 확인 후 저장을 누르세요."
                     FontSize="10" Foreground="#FF9B5D12" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="정답 영역 선택" Command="{Binding CaptureCorrectionCommand}"
                    Style="{StaticResource QuietButton}" FontSize="11" />
            <Button Grid.Column="2" Content="저장" Command="{Binding SaveCorrectionCommand}"
                    Style="{StaticResource QuietButton}" FontSize="11" />
            <Button Grid.Column="4" Content="취소" Command="{Binding CancelCorrectionEditCommand}"
                    Style="{StaticResource QuietButton}" FontSize="11" />
          </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="5" Margin="17,9,17,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="다시 찾기" Command="{Binding RecoveryCommand}"
                  Style="{StaticResource BottomActionButton}" />
          <Button Grid.Column="2" Content="작업 취소" Command="{Binding CancelCommand}"
                  Style="{StaticResource BottomActionButton}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="표시된 버튼은 사용자가 직접 눌러야 합니다."
                   Foreground="#FF84878E" FontSize="10" TextAlignment="Center" Margin="0,9,0,0" />
      </Grid>
    </Grid>
  </Border>
</Window>
